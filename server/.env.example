# 이 파일을 .env로 복사해서 값을 채운다. .env는 git에 올라가지 않는다.

# Google AI Studio(https://aistudio.google.com)에서 발급한 Gemini API 키
GEMINI_API_KEY=

# 선택: 쓸 모델. 기본값 gemini-3.8-flash (무료 등급 있음)
# GEMINI_MODEL=gemini-3.8-flash

# 선택: DB 주소. 기본값은 저장소 루트 compose.yaml의 개발용 DB
# DATABASE_URL=postgres://fridge:fridge@localhost:5433/fridge
